# Content / CMS
# Leave unset to use the local JSON store (data/recipes.json) with seeded recipes.
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# SANITY_API_READ_TOKEN=
# SANITY_API_WRITE_TOKEN=

# Auth.js (email magic link)
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Public site URL (local default matches npm run dev)
AUTH_URL=http://127.0.0.1:43127

# Bootstrap admin — this email is promoted to role=admin on sign-in
ADMIN_EMAIL=gagekehoe17@gmail.com

# Email delivery (optional for local)
# Without these, magic links are printed in the `npm run dev` terminal.
# AUTH_RESEND_KEY=
# EMAIL_FROM=Gregg's Recipes <onboarding@resend.dev>
# Optional SMTP instead of Resend (unused when AUTH_RESEND_KEY is set):
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587

# Production DB note: local auth uses SQLite at data/auth.sqlite.
# On Vercel, prefer Postgres/Neon for durable sessions — see docs/hosting.md.

# Review photo uploads (local/dev writes under public/uploads/reviews/).
# Production should use object storage later — see docs/reviews-comments.md.
# REVIEW_UPLOAD_DRIVER=local
# REVIEW_UPLOAD_BUCKET=
# REVIEW_UPLOAD_PUBLIC_BASE_URL=
