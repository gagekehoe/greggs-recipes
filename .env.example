# Content / CMS (optional / legacy)
# Production recipes use Neon when DATABASE_URL is set — Sanity is not required.
# Leave unset to use the database (or local JSON/seed fallback).
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# SANITY_API_READ_TOKEN=
# SANITY_API_WRITE_TOKEN=

# Auth.js (email magic link)
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Public site URL (local default matches npm run dev)
AUTH_URL=http://127.0.0.1:43127

# Bootstrap admin — this email is promoted to role=admin on sign-in
ADMIN_EMAIL=gagekehoe17@gmail.com

# Email delivery (optional for local)
# Without these, magic links are printed in the `npm run dev` terminal.
# AUTH_RESEND_KEY=
# EMAIL_FROM=Gregg's Recipes <noreply@greggsrecipes.com>
# (Prod: use a Resend-verified address on greggsrecipes.com — not onboarding@resend.dev)
# Optional SMTP instead of Resend (unused when AUTH_RESEND_KEY is set):
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587

# Database
# Local (default): leave DATABASE_URL unset → better-sqlite3 at data/auth.sqlite
#   (auth + reviews + recipe catalog all live in SQLite locally)
# Production (Vercel): set Neon Postgres connection string
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# After creating a Neon project (or when the recipe table is new):
#   1. Copy the connection string into Vercel as DATABASE_URL
#   2. Locally: export DATABASE_URL=... && npm run db:push
#      (or run drizzle/0001_recipe_catalog.sql in the Neon SQL editor
#       if auth tables already exist from 0000_neon_init.sql)
# See docs/hosting.md and docs/production-recipes.md

# Photo uploads (recipe hero + review photos)
# Local/dev: leave unset → writes under public/uploads/{recipes|reviews}/
# Production (Vercel): create a Blob store and set the read/write token.
#   Vercel Dashboard → Storage → Create Blob Store → connect project →
#   copy BLOB_READ_WRITE_TOKEN into Project → Settings → Environment Variables
# See docs/recipe-photo-upload.md (project store) / hosting.md
# BLOB_READ_WRITE_TOKEN=
